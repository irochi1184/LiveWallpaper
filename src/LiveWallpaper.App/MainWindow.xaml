<Window
    x:Class="LiveWallpaper.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            MaxWidth="520">
            <TextBlock
                Text="LiveWallpaper"
                FontSize="32"
                FontWeight="SemiBold" />
            <TextBlock
                Text="プライマリ画面に秒付き時計を表示します。この画面を閉じると時計も終了します。"
                TextWrapping="Wrap"
                Opacity="0.72" />
            <Button
                x:Name="ShowWallpaperButton" AutomationProperties.AutomationId="ShowWallpaperButton" Content="時計をデスクトップに表示"
                Click="ShowWallpaperButton_Click"
                HorizontalAlignment="Stretch" />
            <Button
                x:Name="CloseWallpaperButton" AutomationProperties.AutomationId="CloseWallpaperButton" IsEnabled="False" Content="時計を閉じる"
                Click="CloseWallpaperButton_Click"
                HorizontalAlignment="Stretch" />
            <TextBlock
                x:Name="StatusText" AutomationProperties.AutomationId="StatusText"
                Text="未開始"
                TextWrapping="Wrap"
                Opacity="0.72" />
        </StackPanel>
    </Grid>
</Window>
